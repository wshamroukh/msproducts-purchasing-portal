# ---- Server ----
PORT=3000
# Comma separated list of SPA origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Authentication ----
# entra = validate Entra ID access tokens (production)
# dev   = NO token validation, user is taken from x-dev-user / x-dev-admin headers (local only!)
AUTH_MODE=dev
TENANT_ID=00000000-0000-0000-0000-000000000000
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_SCOPE_NAME=access_as_user
ADMIN_ROLE=Store.Admin

# ---- SQL Server ----
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=msstoredb
# password | managed-identity | access-token
SQL_AUTH=password
SQL_USER=sa
SQL_PASSWORD=Your_strong_Passw0rd!
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
# Create tables + seed sample data on startup (handy for local dev)
DB_AUTO_INIT=true
